# Model for every agent. Default runs locally on Ollama, for free.
TRAVEL_MODEL=ollama:qwen3-coder-next:latest
# TRAVEL_MODEL=anthropic:claude-haiku-5-5   (paid; needs ANTHROPIC_API_KEY and `uv sync --extra anthropic`)

# How long a search takes, in seconds, like a real fare or hotel search.
# A change of plans can only interrupt a search that is still running, so the
# change tests need these above one supervisor turn. Set to 0 to just click around.
FLIGHT_SEARCH_SECONDS=30
HOTEL_SEARCH_SECONDS=20
