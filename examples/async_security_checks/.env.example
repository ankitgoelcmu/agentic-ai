# Model for every agent, as "provider:model". Default runs locally on Ollama, for free.
SECURITY_MODEL=ollama:qwen3-coder-next:latest
# SECURITY_MODEL=anthropic:claude-haiku-5-5   (needs ANTHROPIC_API_KEY and the `anthropic` extra)

# Simulated tool latency in seconds. Each check must still be running after the
# supervisor's first reply, so keep these well above one supervisor turn.
INJECTION_SCAN_SECONDS=20
DLP_SCAN_SECONDS=30
SANDBOX_SECONDS=90

# Optional tracing
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=async-security-checks
